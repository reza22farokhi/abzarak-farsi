  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ابزارک فارسی",
  "url": "https://reza22farokhi.github.io/abzarak-farsi/",
  "description": "مجموعه ابزارهای آنلاین رایگان فارسی",
